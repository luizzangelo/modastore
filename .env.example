# Public values. The publishable key is designed for browser use and is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_ALLOW_SIGNUP=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Base64-encoded 32-byte AES key used at build time for stable Server Actions.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Unique release identifier used by self-hosted rolling deployments.
DEPLOYMENT_VERSION=development
